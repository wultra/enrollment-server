{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/api/v2/docver",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.imageFront.base64",
          "matches": "^eyJ0eXBlIj.*"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "body-document-verification-dynamic-response.json"
  }
}